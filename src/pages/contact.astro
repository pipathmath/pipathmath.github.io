---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/contact.css";

const consultationUrl = "https://calendly.com/pipathmath/free-15-minute-tutoring-consultation";
const pageTitle = "Contact PiPath Academy | Math Tutoring & SAT Math";
const pageDescription =
  "Contact PiPath Academy about personalized math tutoring, small-group tutoring, or the Digital SAT Math Bootcamp.";
---

<SiteLayout title={pageTitle} description={pageDescription} canonicalPath="/contact" socialImagePath="/Orlando.png">
  <SiteHeader activePage="contact" ctaHref="#inquiry-form" ctaLabel="Send an inquiry" />

  <main id="main-content" class="contact-main">
    <div class="site-container contact-layout">
      <section class="contact-intro" aria-labelledby="contact-heading">
        <h1 id="contact-heading">Speak with us directly.</h1>
        <p class="contact-lead">
          Tell us what your student is working on and what kind of support you would like.
        </p>

        <div class="contact-choice">
          <h2>Free 15-Minute Zoom Consultation</h2>
          <a class="button button-primary button-full" href={consultationUrl} target="_blank" rel="noreferrer">Book now</a>
        </div>

        <div class="contact-direct">
          <span>Prefer email?</span>
          <a href="mailto:pipathmath@gmail.com">pipathmath@gmail.com</a>
        </div>
      </section>

      <section class="contact-form-panel" aria-labelledby="form-heading">
        <div class="contact-form-heading">
          <h2 id="form-heading">How can we help?</h2>
        </div>

        <form class="contact-form" id="inquiry-form" novalidate>
          <div class="contact-honeypot" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="contact-field-row">
            <div class="contact-field">
              <label for="contact-name">Your name</label>
              <input id="contact-name" name="contactName" type="text" autocomplete="name" maxlength="120" required />
            </div>
            <div class="contact-field">
              <label for="contact-email">Email</label>
              <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
            </div>
          </div>

          <div class="contact-field-row">
            <div class="contact-field">
              <label for="contact-phone">Phone <span>optional</span></label>
              <input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
            </div>
            <div class="contact-field">
              <label for="inquiry-type">I'm interested in</label>
              <select id="inquiry-type" name="inquiryType" required>
                <option value="math-tutoring">One-on-one math tutoring</option>
                <option value="small-group">Small-group tutoring</option>
                <option value="admissions-coaching">Admissions coaching</option>
                <option value="sat-bootcamp">SAT Math Bootcamp</option>
                <option value="other">Something else</option>
              </select>
            </div>
          </div>

          <div class="contact-field">
            <label for="student-course">Student's grade and course <span>optional</span></label>
            <input id="student-course" name="studentCourse" type="text" maxlength="160" placeholder="For example: 10th grade, Algebra II" />
          </div>

          <div class="contact-field">
            <label for="contact-message">Your message to us</label>
            <textarea id="contact-message" name="message" rows="5" maxlength="1500" required></textarea>
          </div>

          <p class="contact-form-status" id="inquiry-status" aria-live="polite"></p>
          <button class="button button-primary button-full" type="submit">Send inquiry</button>
        </form>

        <div class="contact-success" id="inquiry-success" role="status" tabindex="-1" hidden>
          <span aria-hidden="true">✓</span>
          <h2>Thank you for reaching out.</h2>
          <p>Your inquiry has been sent to PiPath Academy.</p>
          <a href="/">Return to the PiPath home page</a>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />

  <script>
    const inquiryForm = document.querySelector("#inquiry-form");
    const inquiryStatus = document.querySelector("#inquiry-status");
    const inquirySuccess = document.querySelector("#inquiry-success");
    const inquiryType = document.querySelector("#inquiry-type");

    const topicAliases: Record<string, string> = {
      "math-tutoring": "math-tutoring",
      tutoring: "math-tutoring",
      "small-group": "small-group",
      "admissions-coaching": "admissions-coaching",
      sat: "sat-bootcamp",
      "sat-bootcamp": "sat-bootcamp",
      other: "other",
    };

    if (inquiryType instanceof HTMLSelectElement) {
      const requestedTopic = new URLSearchParams(window.location.search).get("topic") ?? "";
      inquiryType.value = topicAliases[requestedTopic] ?? "math-tutoring";
    }

    const readCookie = (name: string) => {
      const match = document.cookie.match(new RegExp(`(?:^|; )${name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}=([^;]*)`));
      return match ? decodeURIComponent(match[1]) : null;
    };

    const attribution = () => {
      const params = new URLSearchParams(window.location.search);
      return {
        gaClientId: readCookie("_ga"),
        utmSource: params.get("utm_source"),
        utmMedium: params.get("utm_medium"),
        utmCampaign: params.get("utm_campaign"),
        utmContent: params.get("utm_content"),
        utmTerm: params.get("utm_term"),
        gclid: params.get("gclid"),
        landingPage: window.location.href,
        referrer: document.referrer || null,
      };
    };

    if (inquiryForm instanceof HTMLFormElement && inquiryStatus instanceof HTMLElement && inquirySuccess instanceof HTMLElement) {
      inquiryForm.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!inquiryForm.reportValidity()) return;

        const submitButton = inquiryForm.querySelector("button[type='submit']");
        const data = new FormData(inquiryForm);
        inquiryStatus.textContent = "Sending your inquiry…";
        inquiryStatus.classList.remove("is-error");
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;

        try {
          const response = await fetch("/api/inquiry", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              contactName: data.get("contactName"),
              email: data.get("email"),
              phone: data.get("phone"),
              inquiryType: data.get("inquiryType"),
              studentCourse: data.get("studentCourse"),
              message: data.get("message"),
              website: data.get("website"),
              attribution: attribution(),
            }),
          });

          const result = await response.json().catch(() => ({})) as { message?: string };
          if (!response.ok) throw new Error(result.message || "We could not send your inquiry.");

          inquiryForm.hidden = true;
          inquirySuccess.hidden = false;
          inquirySuccess.focus();
          const analytics = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
          analytics?.("event", "generate_lead", { lead_source: "contact_form", inquiry_type: data.get("inquiryType") });
        } catch (error) {
          inquiryStatus.textContent = `${error instanceof Error ? error.message : "We could not send your inquiry."} You can also email pipathmath@gmail.com.`;
          inquiryStatus.classList.add("is-error");
          if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        }
      });
    }
  </script>
</SiteLayout>
