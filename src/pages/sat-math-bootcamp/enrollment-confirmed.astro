---
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

const title = "Enrollment Confirmation | PiPath Academy";
const description =
  "Payment follow-up information for PiPath Academy's Digital SAT Math Bootcamp.";
---

<SiteLayout
  title={title}
  description={description}
  canonicalPath="/sat-math-bootcamp/enrollment-confirmed"
  robots="noindex, nofollow"
  referrerPolicy="no-referrer"
  analyticsEnabled={false}
>
  <SiteHeader
    activePage="sat"
    showAnnouncement={false}
    ctaHref="/sat-math-bootcamp"
    ctaLabel="Course details"
  />

  <main id="main-content" class="confirmation-section">
    <div class="site-container confirmation-shell">
      <section class="confirmation-card confirmation-status" aria-labelledby="confirmation-title">
        <span class="status-chip">Payment submitted</span>
        <h1 id="confirmation-title">Thank you for registering.</h1>
        <div class="confirmation-next">
          <h2>What happens next</h2>
          <ul>
            <li>Watch for an email from PiPath Academy with course details.</li>
            <li>Keep your Stripe receipt for your records.</li>
          </ul>
        </div>
        <div class="confirmation-actions">
          <a class="button button-primary" href="/sat-math-bootcamp">
            Review the course schedule
          </a>
          <p class="confirmation-help">
            Questions? <a href="mailto:pipathmath@gmail.com">Email PiPath Academy</a>.
          </p>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</SiteLayout>
