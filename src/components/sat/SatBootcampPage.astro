---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../SiteHeader.astro";
import SiteFooter from "../SiteFooter.astro";
import CohortCard from "./CohortCard";
import EnrollmentForm from "./EnrollmentForm";
import { augustSatMathCohort } from "../../data/cohorts";

const pageTitle = "Digital SAT Math Bootcamp | PiPath Academy";
const pageDescription =
  "A live online Digital SAT Math Bootcamp with 10 live hours, personalized practice, practical Desmos instruction, and time-saving test strategies.";
const enrollmentEnabled = import.meta.env.PUBLIC_ENROLLMENT_ENABLED === "true";
const consultationUrl = "https://calendly.com/pipathmath/free-15-minute-tutoring-consultation";
const showTestimonials = false;

const curriculum = [
  {
    week: "Week 1",
    title: "Algebra Foundations",
    description:
      "Linear equations, linear inequalities, slope and intercepts, systems of equations, and modeling word problems with linear equations.",
  },
  {
    week: "Week 2",
    title: "Advanced Math",
    description:
      "Quadratic forms, polynomials, exponential growth/decay, rational expressions, radicals, and recognizing equivalent expressions.",
  },
  {
    week: "Week 3",
    title: "Problem-Solving & Data",
    description:
      "Ratios, rates, density, percentages, scatterplots, statistics, probability and conditional probability.",
  },
  {
    week: "Week 4",
    title: "Geometry & Trigonometry",
    description:
      "Triangles, circles, coordinate geometry, 3D geometry, trigonometry, and geometric applications.",
  },
];

const methodology = [
  {
    number: "01",
    title: "Establish the baseline",
    description: "A diagnostic or recent score reveals which concepts the student needs to strengthen.",
  },
  {
    number: "02",
    title: "Teach the underlying math",
    description:
      "Gaps are filled in the student’s conceptual understanding with an emphasis on understanding the material so that it becomes intuitive, as opposed to just memorizing formulas.",
  },
  {
    number: "03",
    title: "Practice under SAT conditions",
    description:
      "Timed problem-solving happens during the live sessions and students learn how to work through SAT Math problems quickly by using time-saving strategies (including in-depth Desmos tutorials).",
  },
  {
    number: "04",
    title: "Target the follow-up work",
    description: "Personalized homework focuses each student on the topics that they need the most work on.",
  },
];
const methodologyColumns = [methodology.slice(0, 2), methodology.slice(2)];

const faqs = [
  {
    question: "What if my student has not taken an SAT or PSAT yet?",
    answer: "We will use a diagnostic to establish a baseline and identify priority topics.",
  },
  {
    question: "What happens if a student misses a live class?",
    answer: "Recordings will be available, although live attendance is encouraged for discussion and problem-solving.",
  },
  {
    question: "How is the bootcamp personalized?",
    answer: "Core class topics are shared, but assigned practice can be adjusted to each student's needs.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Course",
      "@id": "https://www.pipathacademy.com/sat-math-bootcamp#course",
      name: "Digital SAT Math Bootcamp",
      description: pageDescription,
      url: "https://www.pipathacademy.com/sat-math-bootcamp",
      inLanguage: "en",
      educationalLevel: "High school",
      provider: {
        "@type": "EducationalOrganization",
        name: "PiPath Academy",
        url: "https://www.pipathacademy.com/",
      },
      hasCourseInstance: {
        "@type": "CourseInstance",
        name: augustSatMathCohort.title,
        courseMode: "Online",
        startDate: "2026-08-18",
        endDate: "2026-09-10",
        instructor: {
          "@type": "Person",
          name: "Dr. Orlando Ferrer",
          honorificSuffix: "Ph.D.",
          alumniOf: {
            "@type": "CollegeOrUniversity",
            name: "Duke University",
          },
        },
      },
      offers: {
        "@type": "Offer",
        price: augustSatMathCohort.price.toString(),
        priceCurrency: "USD",
        availability:
          augustSatMathCohort.status === "enrolling"
            ? "https://schema.org/InStock"
            : "https://schema.org/SoldOut",
        url: "https://www.pipathacademy.com/sat-math-bootcamp#schedule",
      },
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.pipathacademy.com/sat-math-bootcamp#faq",
      mainEntity: faqs.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<SiteLayout title={pageTitle} description={pageDescription} canonicalPath="/sat-math-bootcamp" structuredData={structuredData}>
  <SiteHeader activePage="sat" />

  <main id="main-content">
    <section class="hero-section">
      <div class="site-container hero-grid">
        <div class="hero-copy">
          <h1>SAT Math is standardized, but your learning path doesn’t have to be.</h1>
          <p class="hero-lead">
            Four focused weeks of concept-building, live problem-solving, practical Desmos and time-saving test strategies.
          </p>
          <p class="hero-instructor-credit">Taught directly by Orlando Ferrer, Ph.D. in Mathematics from Duke.</p>
        </div>

        <div class="hero-media-column">
          <figure class="hero-artwork">
            <div class="artwork-label">
              <span>PiPath Academy</span>
              <strong>Digital SAT Math</strong>
            </div>
            <div class="course-video-frame">
              <iframe
                src="https://www.youtube-nocookie.com/embed/1IGzsRyCwHU?rel=0"
                title="Digital SAT Math Bootcamp overview with Dr. Orlando Ferrer"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
            <figcaption>Meet the instructor and learn how the SAT Math course works.</figcaption>
          </figure>
          <div class="hero-video-actions" aria-label="Next steps">
            <a class="button button-primary" href="#schedule">View the August schedule</a>
            <a class="button button-secondary" href={consultationUrl} target="_blank" rel="noreferrer">
              Book a free consultation
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="proof-strip" aria-label="Course facts">
      <div class="site-container proof-grid">
        <div><strong>10 live hours</strong><span>Eight live sessions · recordings available</span></div>
        <div><strong>10–15 students</strong><span>Interactive classroom setting</span></div>
        <div><strong>$299 total</strong><span>Complete four-week program</span></div>
        <div><strong>Personalized homework</strong><span>Customized to student's needs</span></div>
      </div>
    </section>

    <section class="section section-schedule" id="schedule">
      <div class="site-container">
        <div class="section-heading">
          <div>
            <p class="section-kicker">Choose your dates</p>
            <h2>The next live cohort</h2>
          </div>
        </div>

        <CohortCard cohort={augustSatMathCohort} client:load />
      </div>
    </section>

    <section class="section section-curriculum" id="curriculum">
      <div class="site-container">
        <div class="section-heading">
          <p class="section-kicker">What we cover</p>
          <h2>Bootcamp Overview</h2>
          <p>A non-comprehensive list of the core concepts that we will touch on each week.</p>
        </div>

        <div class="curriculum-grid">
          {
            curriculum.map((item, index) => (
              <article class="curriculum-card">
                <div class="curriculum-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
                <p>{item.week}</p>
                <h3>{item.title}</h3>
                <div class="card-rule" aria-hidden="true"></div>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section-approach" id="approach">
      <div class="site-container">
        <div class="section-heading approach-intro">
          <p class="section-kicker">The PiPath approach</p>
          <h2>How we prepare students</h2>
        </div>

        <div class="method-columns">
          {
            methodologyColumns.map((column) => (
              <ol class="method-list">
                {column.map((item) => (
                  <li>
                    <span>{item.number}</span>
                    <div>
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                    </div>
                  </li>
                ))}
              </ol>
            ))
          }
        </div>
      </div>
    </section>

    {
      showTestimonials && (
        <section class="section testimonial-section" aria-labelledby="stories-heading">
          <div class="site-container">
            <div class="section-heading compact-heading">
              <p class="section-kicker">Parent perspectives</p>
              <h2 id="stories-heading">A reserved space for real family stories.</h2>
            </div>
            <div class="testimonial-grid">
              <article class="testimonial-placeholder">
                <span>Testimonial placeholder</span>
                <p>An approved parent testimonial will appear here before launch.</p>
              </article>
              <article class="testimonial-placeholder">
                <span>Testimonial placeholder</span>
                <p>A second approved family story will appear here before launch.</p>
              </article>
            </div>
          </div>
        </section>
      )
    }

    <section class="section faq-section">
      <div class="site-container faq-grid">
        <div class="section-heading compact-heading">
          <p class="section-kicker">Questions parents ask</p>
          <h2>Clear expectations before you enroll.</h2>
        </div>

        <div class="faq-list">
          {faqs.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        </div>
      </div>
    </section>

    <section class="enrollment-section" id="enrollment">
      <div class="site-container">
        <div class="checkout-cancelled-notice" role="status" hidden>
          <strong>Checkout canceled.</strong>
          <span>Your family information is saved, but no payment was made and enrollment is not confirmed. Continue below whenever you are ready.</span>
        </div>
      </div>
      <div class="site-container enrollment-inner">
        <div class="enrollment-copy">
          <p class="section-kicker">August enrollment</p>
          <h2>Reserve your student's place.</h2>
          <dl class="enrollment-summary">
            <div><dt>Dates</dt><dd>August 18–September 10</dd></div>
            <div><dt>Schedule</dt><dd>Tuesdays & Thursdays · 7:00–8:15 PM ET</dd></div>
            <div><dt>Format</dt><dd>8 live online sessions · 10 total hours</dd></div>
            <div><dt>Tuition</dt><dd>$299 for the complete program</dd></div>
          </dl>
          <a class="enrollment-consultation-link" href={consultationUrl} target="_blank" rel="noreferrer">Not ready to enroll? Book a free consultation</a>
        </div>
        <div class="enrollment-action">
          <EnrollmentForm
            cohortId={augustSatMathCohort.id}
            price={augustSatMathCohort.price}
            enabled={enrollmentEnabled}
            consultationUrl={consultationUrl}
            client:load
          />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <a class="mobile-enroll-bar" href="#enrollment">
    <span>August cohort · $299</span>
    <strong>Enroll now</strong>
  </a>

  <script>
    const checkoutNotice = document.querySelector(".checkout-cancelled-notice");
    const checkoutState = new URLSearchParams(window.location.search).get("checkout");

    if (checkoutState === "cancelled" && checkoutNotice instanceof HTMLElement) {
      checkoutNotice.hidden = false;
    }

    const enrollmentSection = document.querySelector("#enrollment");
    const mobileEnrollmentBar = document.querySelector(".mobile-enroll-bar");

    if (enrollmentSection instanceof HTMLElement && mobileEnrollmentBar instanceof HTMLElement) {
      const enrollmentObserver = new IntersectionObserver(([entry]) => {
        mobileEnrollmentBar.classList.toggle("is-hidden", entry.isIntersecting);
      }, { threshold: 0.05 });

      enrollmentObserver.observe(enrollmentSection);
    }
  </script>
</SiteLayout>
