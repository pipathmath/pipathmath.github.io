---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  structuredData?: Record<string, unknown>;
  robots?: string;
  referrerPolicy?: string;
  analyticsEnabled?: boolean;
  socialImagePath?: string;
}

const {
  title,
  description,
  canonicalPath,
  structuredData,
  robots,
  referrerPolicy,
  analyticsEnabled = true,
  socialImagePath = "/bootcamp-header.png",
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const socialImageUrl = new URL(socialImagePath, Astro.site);
const analyticsId = "G-EXV4N60WP8";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00539b" />
    {robots && <meta name="robots" content={robots} />}
    {referrerPolicy && <meta name="referrer" content={referrerPolicy} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon-512.png?v=6" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon-512.png?v=6" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {
      analyticsEnabled && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() { window.dataLayer.push(arguments); }
            gtag("js", new Date());
            gtag("config", "G-EXV4N60WP8");
          </script>
        </>
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
